#!/bin/sh
# Offline stand-in for `kscreen-doctor -j`; mirrors the fields the topology
# scan reads. The active mode follows LEGION_MOCK_SCENARIO.

scenario="${LEGION_MOCK_SCENARIO:-single-32:9}"
connector="${LEGION_MOCK_CONNECTOR:-DP-2}"

case "$scenario" in
    single-16:9) width=1920; height=1080 ;;
    single-21:9|pip-21:9) width=3440; height=1440 ;;
    pbp-32:9|pbp-32:9-75) width=2560; height=1440 ;;
    *) width=5120; height=1440 ;;
esac

cat <<EOF
{
  "outputs": [
    {
      "id": 1,
      "name": "$connector",
      "connected": true,
      "enabled": true,
      "clones": [],
      "currentModeId": "7",
      "modes": [
        {"id": "7", "name": "${width}x${height}@60", "refreshRate": 60.0, "size": {"width": $width, "height": $height}}
      ]
    }
  ]
}
EOF
